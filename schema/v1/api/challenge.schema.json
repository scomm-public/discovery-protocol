{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.scomm.ai/schema/v1/api/challenge.schema.json",
  "title": "Discovery challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "satisfied", "expired", "failed", "consumed"]
    },
    "purpose": {
      "type": "string",
      "format": "uri"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "attemptsRemaining": {
      "type": "integer",
      "minimum": 0
    },
    "nonce": {
      "type": "string",
      "description": "oidc-id-token create only: the nonce the ID token must carry"
    },
    "otp_grant": {
      "type": "string",
      "description": "Respond only: the grant for the purpose (otp-grants.md)"
    },
    "vault_grant": {
      "type": "string",
      "description": "Respond only, replace_msk: signed vault-audience grant"
    },
    "identity_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Respond only, vault purposes: OPRF identity"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Respond only, directory purposes: mailbox hash"
    }
  }
}
