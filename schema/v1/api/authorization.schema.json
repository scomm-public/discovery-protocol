{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.scomm.ai/schema/v1/api/authorization.schema.json",
  "$comment": "Logical authorization descriptor. SComm hosted profile embeds MSK proof in the signed mutation envelope instead.",
  "title": "Authorization descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["method"],
  "properties": {
    "method": {
      "type": "string",
      "enum": ["msk", "previous-msk", "challenge"]
    },
    "profile": {
      "type": "string",
      "format": "uri"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "challengeId": {
      "type": "string",
      "minLength": 1
    },
    "proof": {
      "type": "string",
      "minLength": 1
    }
  }
}
