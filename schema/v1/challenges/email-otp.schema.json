{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.scomm.ai/schema/v1/challenges/email-otp.schema.json",
  "title": "Email OTP challenge create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "purpose", "email"],
  "properties": {
    "type": {
      "type": "string",
      "const": "https://discovery.scomm.ai/challenges/email-otp/v1"
    },
    "purpose": {
      "type": "string",
      "format": "uri",
      "description": "Operation or recovery purpose this challenge authorizes when satisfied"
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "description": "Mailbox to send the code to. Its canonical SHA-256 MUST equal the path mailboxSha256. Not stored."
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "msk_jkt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url SHA-256 of the raw MSK public key. Required when the purpose arms an MSK."
    }
  }
}
