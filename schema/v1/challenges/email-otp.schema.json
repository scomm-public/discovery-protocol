{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.scomm.ai/schema/v1/challenges/email-otp.schema.json",
  "title": "Email OTP challenge create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "purpose"],
  "properties": {
    "type": {
      "type": "string",
