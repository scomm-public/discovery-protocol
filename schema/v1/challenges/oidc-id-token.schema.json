{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.scomm.ai/schema/v1/challenges/oidc-id-token.schema.json",
  "title": "OIDC ID token challenge create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "purpose", "provider"],
  "properties": {
    "type": {
      "type": "string",
      "const": "https://discovery.scomm.ai/challenges/oidc-id-token/v1"
    },
    "purpose": {
      "type": "string",
      "format": "uri",
      "description": "Operation or recovery purpose this challenge authorizes when satisfied"
    },
    "provider": {
      "type": "string",
      "enum": ["google", "microsoft"]
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "msk_jkt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url SHA-256 of the raw Ed25519 MSK public key. Required when the purpose arms an MSK."
    }
  }
}
